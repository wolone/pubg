{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pubg",
	"compatibility_date": "2026-09-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pubg-stats",
			"migrations_dir": "./migrations",
			// Add the UUID returned by `wrangler d1 create pubg-stats --location apac`
			// as `database_id` before a remote migration or production deploy.
		},
		{
			"binding": "pubg",
			"database_name": "pubg",
			"database_id": "8085d927-8a8e-40c3-8818-a93d740b61fb",
			"remote": true
		},
	],
	"env": {
		"preview": {
			"name": "pubg-preview",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "pubg-stats-preview",
					"migrations_dir": "./migrations",
					// Add `database_id` after creating the preview D1 database.
				},
			],
		},
		"production": {
			"name": "pubg",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "pubg-stats",
					"migrations_dir": "./migrations",
					// Add `database_id` after creating the production D1 database.
				},
			],
		},
	},
	"main": "vinext/server/fetch-handler",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS",
	},
	"cache": {
		"enabled": true,
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},
}